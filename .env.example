# Copier ce fichier en .env et adapter les valeurs. Ne jamais committer .env.

# Backend
ENVIRONMENT=development
DATABASE_URL=postgresql://handtech:changeme@db:5432/handtech
AI_SERVICE_URL=http://ai-service:8001
GOOGLE_CLIENT_ID=

# LibreTranslate (service interne Docker)
LIBRETRANSLATE_URL=http://libretranslate:5000
LIBRETRANSLATE_API_KEY=
TRANSLATION_TIMEOUT_SECONDS=30

# Origines exactes autorisées pour Flutter Web (format JSON).
# Exemple : ["https://app.example.org"]
CORS_ALLOWED_ORIGINS=[]

# Base de données (docker-compose)
POSTGRES_USER=handtech
POSTGRES_PASSWORD=changeme
POSTGRES_DB=handtech
